# Rust
/rust-core/target/

# Node
/extension/node_modules/
/extension/out/
/extension/dist/
/extension/webview/dist/
/extension/webview/node_modules/
# tree-sitter-cli, installed only to regenerate the vendored forester parser
/rust-core/tree-sitter-forester/node_modules/
extension/package-lock.json
research/
# Packaged extension artifacts (produced by `just install-local`)
extension/*.vsix

# Protobuf
/proto/gen/
/rust-core/proto/
# extension proto bindings — regenerated from proto/checker.proto on each
# `pnpm install` (via prepare) and before build/lint/typecheck.
/extension/src/proto/checker.js
/extension/src/proto/checker.d.ts

# Sphinx docs
docs/_build/
docs/.venv/
docs/_ext/__pycache__/
*.mo

# Debug/test output
out.xml

# Misc
.DS_Store
*.log
.vscode/
# Except where the workspace setting is the fixture: the UI tests cannot
# change a setting from inside the window the way the e2e suites do.
!extension/src/test/fixtures/uiInspectorLive/.vscode/
refs/
# Notes on bugs found in dependencies, until they are filed upstream.
.upstream-issues/
test.md
test.txt
.serena/
plans/
spellcheck_wordlists.json
# Local prose-insights cache
.languagecheck.db
**/.languagecheck.db
.cache/

# Prose checking for this repository's own docs. The Vale package is fetched
# by `vale sync`, not vendored: 137 rule files would otherwise sit in the diff
# of every unrelated change. `.languagecheck/` is the local dictionary and
# ignore store, which is per-checkout state.
.vale/styles/
.languagecheck/
