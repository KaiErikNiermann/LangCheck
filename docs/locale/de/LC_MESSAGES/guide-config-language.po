#: ../../guide-config-language.md:13
msgid "Use an SLS schema when:"
msgstr "Use an SLS schema when:"

#: ../../guide-config-language.md:15
msgid "the format is mostly line-oriented markup or config,"
msgstr "the format is mostly line-oriented markup or config,"

#: ../../guide-config-language.md:16
msgid "you can describe prose lines with regular expressions,"
msgstr "you can describe prose lines with regular expressions,"

#: ../../guide-config-language.md:17
msgid "code blocks or metadata can be skipped with simple line or block rules, and"
msgstr "code blocks or metadata can be skipped with simple line or block rules, and"

