msgstr "Everything between `~~~` fences is excluded from checking."

#: ../../tinylang-spec.md:61
msgid "Comments"
msgstr "Comments"

#: ../../tinylang-spec.md:63
msgid "Line comments starting with `//`:"
msgstr "Line comments starting with `//`:"

#: ../../tinylang-spec.md:69
msgid "Comments are excluded from checking."
msgstr "Comments are excluded from checking."

#: ../../tinylang-spec.md:71
msgid "Math"
msgstr "Math"

#: ../../tinylang-spec.md:73
msgid "Inline math: `$expression$` Display math: `$$expression$$`"
msgstr "Inline math: `$expression$` Display math: `$$expression$$`"

#: ../../tinylang-spec.md:76
msgid "Math content is excluded from checking. Display math creates an exclusion zone (content replaced with spaces to preserve offsets, same as LaTeX `\\[...\\]` and Forester `##{...}`)."
msgstr "Math content is excluded from checking. Display math creates an exclusion zone (content replaced with spaces to preserve offsets, same as LaTeX `\\[...\\]` and Forester `##{...}`)."

