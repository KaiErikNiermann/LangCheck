msgid "Inline code: `` `code` ``"
msgstr "Inline code: `` `code` ``"

#: ../../tinylang-spec.md:45
msgid "Code content is **not** prose and is excluded from checking."
msgstr "Code content is **not** prose and is excluded from checking."

#: ../../tinylang-spec.md:47
msgid "Code Blocks"
msgstr "Code Blocks"

#: ../../tinylang-spec.md:49
msgid "Fenced with `~~~` on their own lines:"
msgstr "Fenced with `~~~` on their own lines:"

#: ../../tinylang-spec.md:59
