#: ../../guide/neovim-setup.md:1
msgid "Neovim Setup"
msgstr ""

#: ../../guide/neovim-setup.md:3
msgid ""
"Language Check provides a native Neovim plugin that connects to the "
"`language-check-server` binary via LSP. It supports Neovim 0.10+ and "
"works with lazy.nvim, packer.nvim, vim-plug, or the built-in Neovim 0.11+"
" LSP config."
msgstr ""

