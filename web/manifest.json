{
  "manifest_version": 3,
  "name": "LangCheck for web editors",
  "version": "0.1.0",
  "description": "Prose checking in {sites}, by the LangCheck core running on your machine.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "language-check@kaierikniermann.github.io",
      "strict_min_version": "128.0"
    }
  },
  "minimum_chrome_version": "128",
  "web_accessible_resources": [
    {
      "resources": [
        "palette.html",
        "palette.js"
      ],
      "matches": []
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
