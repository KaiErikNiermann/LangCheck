{
  "manifest_version": 3,
  "name": "LangCheck for web editors",
  "version": "0.1.0",
  "description": "Prose checking in Overleaf, Typst and Notion, by the LangCheck core running on your machine.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "content-overleaf.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "page-overleaf.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://typst.app/project/*"
      ],
      "js": [
        "content-typst.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://typst.app/project/*"
      ],
      "js": [
        "page-typst.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.notion.com/*",
        "https://www.notion.so/*"
      ],
      "js": [
        "content-notion.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.notion.com/*",
        "https://www.notion.so/*"
      ],
      "js": [
        "page-notion.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "language-check@kaierikniermann.github.io",
      "strict_min_version": "128.0"
    }
  },
  "minimum_chrome_version": "128",
  "web_accessible_resources": [
    {
      "resources": [
        "palette.html",
        "palette.js"
      ],
      "matches": [
        "https://app.notion.com/*",
        "https://typst.app/*",
        "https://www.notion.so/*",
        "https://www.overleaf.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
