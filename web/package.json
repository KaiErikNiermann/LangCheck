{
  "name": "language-check-web",
  "version": "0.1.0",
  "private": true,
  "description": "LangCheck for web editors (Overleaf, Typst): the VS Code frontend's checking path behind a vscode shim, talking to the core through a native messaging host.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "prepare": "pnpm --dir ../extension run proto:gen",
    "build:webview": "pnpm --dir ../extension run build:webview",
    "build": "pnpm run build:webview && node esbuild.mjs",
    "build:test": "pnpm run build:webview && node esbuild.mjs --test",
    "dev": "pnpm run build:webview && node esbuild.mjs --dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test *.mjs *.mts",
    "test": "vitest run",
    "test:e2e": "pnpm run build:test && playwright test",
    "bench": "playwright test -c playwright.bench.config.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:e2e"
  },
  "devDependencies": {
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/path-browserify": "^1.0.3",
    "@types/webextension-polyfill": "^0.12.6",
    "@types/ws": "^8.18.2",
    "cm-lint-6-9-5": "npm:@codemirror/lint@6.9.5",
    "cm-view-6-38": "npm:@codemirror/view@6.38.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "monaco-editor": "^0.57.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "hotkeys-js": "^3.13.15",
    "ninja-keys": "file:../../../web-tooling/ninja-keys",
    "path-browserify": "^1.0.1",
    "webextension-polyfill": "^0.12.0"
  }
}
