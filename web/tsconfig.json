{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    // The reused VS Code client modules import `vscode`; here that is the
    // shim, so this typecheck also proves the shim covers what they use.
    "paths": { "vscode": ["./src/shim/vscode.ts"] }
  },
  "include": ["src"]
}
